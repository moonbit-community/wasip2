import {
  "peter-jerry-ye/wasip2",
  "peter-jerry-ye/wasip2/stdio",
  "peter-jerry-ye/wasip2/async",
  "peter-jerry-ye/wasip2/async/cond_var",
  "peter-jerry-ye/wasip2/async/aqueue",
  "peter-jerry-ye/wasip2/http",
  "peter-jerry-ye/wasip2/fs",
}

warnings = "-44"

options(
  link: {
    "wasm": {
      "export-memory-name": "memory",
      "exports": [
        "mbt_ffi_cabi_realloc:cabi_realloc",
        "wasmExportRun:wasi:cli/run@0.2.9#run",
      ],
      "heap-start-address": 16,
    },
  },
)
